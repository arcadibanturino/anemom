# Salin menjadi .env lalu isi. JANGAN commit .env (berisi sandi).
APP_DEBUG=false
APP_TIMEZONE=Asia/Makassar
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=anemom
DB_USER=anemom_app
DB_PASS=
STORAGE_PATH=/var/www/anemom/storage
MAX_UPLOAD_MB=8
TOKEN_TTL_DAYS=30
# Layanan AI mata (ml-service). Kosongkan bila belum dipasang: foto mata berstatus "queued".
INFERENCE_URL=http://127.0.0.1:8001
INFERENCE_TIMEOUT=20
