       }
      ],
      "url": {
       "raw": "{{baseUrl}}/auth/register",
       "host": [
        "{{baseUrl}}"
       ],
       "path": [
        "auth",
        "register"
       ]
      },
      "auth": {
       "type": "noauth"
      },
      "body": {
       "mode": "raw",
       "raw": "{\n  \"name\": \"Rani Pratiwi\",\n  \"email\": \"rani@email.com\",\n  \"password\": \"sandi12345\",\n  \"hpht\": \"2026-06-01\",\n  \"birth_date\": \"1998-05-10\",\n  \"health_facility\": \"Puskesmas Tamalanrea\"\n}"
      },
      "description": "Token otomatis disimpan ke variabel {{token}}."
     },
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "const j = pm.response.json();",
         "if (j.data && j.data.token) { pm.collectionVariables.set('token', j.data.token); }",
         "pm.test('status ok', () => pm.expect(pm.response.code).to.be.oneOf([200,201]));"
        ]
       }
      }
     ]
    },
    {
     "name": "Login",
