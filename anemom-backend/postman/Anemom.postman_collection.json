{
 "info": {
  "name": "Anemom API v1",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Jalankan Register atau Login dulu; token tersimpan otomatis. Ubah variabel baseUrl ke alamat VPS."
 },
 "auth": {
  "type": "bearer",
  "bearer": [
   {
    "key": "token",
    "value": "{{token}}",
    "type": "string"
   }
  ]
 },
 "variable": [
  {
   "key": "baseUrl",
